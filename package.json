{
  "name": "react-example",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "BRUTAL — a local-first music player.",
  "author": "kuroyagi6",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuroyagi6/BRUTAL-PLAY.git"
  },
  "scripts": {
    "dev": "vite --port=3042 --host=0.0.0.0",
    "electron": "wait-on tcp:3042 && cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "dist": "npm run build && electron-builder --publish never",
    "publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "electron-updater": "^6.3.9",
    "idb": "^8.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "music-metadata": "^7.14.0",
    "music-metadata-browser": "^2.5.11",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
